new file mode 100644
index 0000000000..b81a4c9368
--- /dev/null
+++ b/Swiftgram/SGSimpleSettings/Sources/SwirixHiddenChats.swift
@@ -0,0 +1,36 @@
+import Foundation
+
+public final class SwirixHiddenChats {
+    public static let shared = SwirixHiddenChats()
+    public static let changed = Notification.Name("swiryyyyX.hiddenChats.changed")
+    private let lock = NSLock()
+    private let defaults: UserDefaults
+    private var cache: [Int64: Set<Int64>] = [:]
+
+    public init(defaults: UserDefaults? = nil) {
+        self.defaults = defaults ?? UserDefaults(suiteName: APP_GROUP_IDENTIFIER) ?? .standard
+    }
+
+    private func key(_ account: Int64) -> String { return "swiryyyyX.hidden.v1.\(account)" }
+
+    public func ids(account: Int64, refresh: Bool = false) -> Set<Int64> {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        if !refresh, let value = self.cache[account] { return value }
+        let value = Set((self.defaults.stringArray(forKey: self.key(account)) ?? []).compactMap(Int64.init))
+        self.cache[account] = value
+        return value
+    }
+
+    public func setHidden(account: Int64, peer: Int64, hidden: Bool) {
+        guard peer != account else { return }
+        self.lock.lock()
+        var value = self.cache[account] ?? Set((self.defaults.stringArray(forKey: self.key(account)) ?? []).compactMap(Int64.init))
+        if hidden { value.insert(peer) } else { value.remove(peer) }
+        self.cache[account] = value
+        self.defaults.set(value.sorted().map(String.init), forKey: self.key(account))
+        self.lock.unlock()
+        NotificationCenter.default.post(name: Self.changed, object: nil)
+    }
+
+}
