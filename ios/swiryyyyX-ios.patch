diff --git a/submodules/TelegramUI/Sources/SwirixForwardQueue.swift b/submodules/TelegramUI/Sources/SwirixForwardQueue.swift
new file mode 100644
index 0000000000..4a0afbba07
--- /dev/null
+++ b/submodules/TelegramUI/Sources/SwirixForwardQueue.swift
@@ -0,0 +1,137 @@
+import Foundation
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+import SGSimpleSettings
+
+// Main-queue owned. Retained independently of the forwarding picker/controller.
+// A failed or uncertain recipient stops the job; it is never replayed on launch.
+final class SwirixForwardQueue {
+    private static var jobs: [Int64: SwirixForwardQueue] = [:]
+    private let context: AccountContext
+    private let recipients: [EnginePeer.Id]
+    private let messages: [EnqueueMessage]
+    private let disposable = MetaDisposable()
+    private var observer: NSObjectProtocol?
+    private let accountDisposable = MetaDisposable()
+    private var correlations: [Int64] = []
+    private var deliveryStartedAt: TimeInterval = 0
+    private var position = 0
+    private var cancelled = false
+    private let completion: (String) -> Void
+
+    static func isRunning(context: AccountContext) -> Bool {
+        return jobs[context.account.peerId.toInt64()] != nil
+    }
+
+    static func cancel(context: AccountContext) {
+        let key = context.account.peerId.toInt64()
+        guard let job = jobs.removeValue(forKey: key) else { return }
+        job.cancelled = true
+        job.disposable.dispose()
+        job.completion("Чергу зупинено. Уже відправлені повідомлення не відкликаються.")
+    }
+
+    static func start(context: AccountContext, recipients: [EnginePeer.Id], messages: [EnqueueMessage], completion: @escaping (String) -> Void) -> Bool {
+        let key = context.account.peerId.toInt64()
+        guard jobs[key] == nil, !messages.isEmpty, !recipients.isEmpty else { return false }
+        var seen = Set<EnginePeer.Id>()
+        let snapshot = recipients.filter { seen.insert($0).inserted }
+        let job = SwirixForwardQueue(context: context, recipients: snapshot, messages: messages, completion: completion)
+        jobs[key] = job
+        job.observer = NotificationCenter.default.addObserver(forName: Notification.Name("swiryyyyX.forward.stop"), object: nil, queue: .main) { [weak job] notification in
+            guard let job, let account = notification.object as? NSNumber, account.int64Value == key else { return }
+            Self.cancel(context: job.context)
+        }
+        job.accountDisposable.set((context.sharedContext.activeAccountsWithInfo |> deliverOnMainQueue).start(next: { [weak job] info in
+            guard let job, info.primary != context.account.id else { return }
+            Self.cancel(context: job.context)
+        }))
+        job.next()
+        return true
+    }
+
+    private init(context: AccountContext, recipients: [EnginePeer.Id], messages: [EnqueueMessage], completion: @escaping (String) -> Void) {
+        self.context = context
+        self.recipients = recipients
+        self.messages = messages
+        self.completion = completion
+    }
+
+    deinit {
+        if let observer = self.observer { NotificationCenter.default.removeObserver(observer) }
+        self.disposable.dispose()
+        self.accountDisposable.dispose()
+    }
+
+    private func finish(_ text: String) {
+        self.cancelled = true
+        Self.jobs.removeValue(forKey: self.context.account.peerId.toInt64())
+        self.disposable.set(nil)
+        self.completion(text)
+    }
+
+    private func next() {
+        guard !self.cancelled else { return }
+        guard self.position < self.recipients.count else {
+            self.finish("Пересилання завершено: \(self.position) чатів.")
+            return
+        }
+        let peerId = self.recipients[self.position]
+        if SwirixHiddenChats.shared.ids(account: self.context.account.peerId.toInt64()).contains(peerId.toInt64()) {
+            self.finish("Одержувач тепер прихований. Чергу зупинено без повторної відправки.")
+            return
+        }
+        self.correlations = self.messages.map { _ in Int64.random(in: 1 ... Int64.max) }
+        self.deliveryStartedAt = Date().timeIntervalSince1970
+        let outgoing = zip(self.messages, self.correlations).map { $0.0.withUpdatedCorrelationId($0.1) }
+        self.disposable.set((enqueueMessages(account: self.context.account, peerId: peerId, messages: outgoing)
+        |> deliverOnMainQueue).start(next: { [weak self] ids in
+            guard let self, !self.cancelled else { return }
+            let actual = ids.compactMap { $0 }
+            guard actual.count == self.messages.count else {
+                self.finish("Чергу зупинено: не вдалося підтвердити додавання повідомлень. Перевір чат перед повтором.")
+                return
+            }
+            // Deferring avoids replacing a MetaDisposable from a synchronous emission
+            // while its original subscription is still being installed.
+            Queue.mainQueue().async { [weak self] in
+                self?.waitForDelivery(ids: actual)
+            }
+        }))
+    }
+
+    private func waitForDelivery(ids: [EngineMessage.Id]) {
+        guard !self.cancelled else { return }
+        let statuses = ids.map { id in
+            return self.context.account.pendingMessageManager.pendingMessageStatus(id)
+            |> map { status, error -> Int in
+                if error != nil { return -1 }
+                return status == nil ? 1 : 0
+            }
+        }
+        self.disposable.set((combineLatest(statuses)
+        |> filter { values in values.contains(-1) }
+        |> take(1)
+        |> deliverOnMainQueue).start(next: { [weak self] _ in
+            self?.finish("Чергу зупинено через помилку доставки. Перевір поточний чат перед повторним запуском.")
+        }))
+        self.pollAcknowledgements()
+    }
+
+    private func pollAcknowledgements() {
+        guard !self.cancelled else { return }
+        let target = self.recipients[self.position]
+        let acknowledged = self.correlations.allSatisfy { correlation in
+            return self.context.account.pendingMessageManager.synchronouslyLookupCorrelationId(correlationId: correlation)?.peerId == target
+        }
+        if acknowledged {
+            self.position += 1
+            Queue.mainQueue().after(0.2) { [weak self] in self?.next() }
+        } else if Date().timeIntervalSince1970 - self.deliveryStartedAt > 300 {
+            self.finish("Немає підтвердження доставки протягом 5 хвилин. Чергу зупинено. Поточне повідомлення може ще відправитися через Telegram; перевір чат перед повтором.")
+        } else {
+            Queue.mainQueue().after(0.2) { [weak self] in self?.pollAcknowledgements() }
+        }
+    }
+}
