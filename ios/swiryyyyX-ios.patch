diff --git a/Tests/SwirixHiddenChatsTests.swift b/Tests/SwirixHiddenChatsTests.swift
new file mode 100644
index 0000000000..753ca3bb22
--- /dev/null
+++ b/Tests/SwirixHiddenChatsTests.swift
@@ -0,0 +1,30 @@
+import Foundation
+
+let APP_GROUP_IDENTIFIER = "swirix.tests.unused.default"
+
+@main
+enum SwirixHiddenChatsTests {
+    static func main() {
+        let suite = "swirix.hidden.tests.\(UUID().uuidString)"
+        let defaults = UserDefaults(suiteName: suite)!
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let store = SwirixHiddenChats(defaults: defaults)
+        store.setHidden(account: 100, peer: 200, hidden: true)
+        precondition(store.ids(account: 100) == [200], "Hide must persist for this account")
+        precondition(store.ids(account: 101).isEmpty, "A second account must remain isolated")
+        store.setHidden(account: 100, peer: 100, hidden: true)
+        precondition(store.ids(account: 100) == [200], "Saved Messages must remain reachable")
+        let reopened = SwirixHiddenChats(defaults: defaults)
+        precondition(reopened.ids(account: 100) == [200], "Hidden peers must survive restart")
+        store.setHidden(account: 100, peer: 200, hidden: false)
+        precondition(reopened.ids(account: 100, refresh: true).isEmpty, "Extension refresh must see restoration")
+        DispatchQueue.concurrentPerform(iterations: 230) { index in
+            store.setHidden(account: 100, peer: Int64(index + 1000), hidden: true)
+        }
+        precondition(store.ids(account: 100).count == 230, "Concurrent mutations must not lose peers")
+        precondition(reopened.ids(account: 100, refresh: true).count == 230, "All mutations must be persisted")
+        defaults.set(["invalid", "9007199254740993"], forKey: "swiryyyyX.hidden.v1.101")
+        precondition(store.ids(account: 101, refresh: true) == [9007199254740993], "Peer IDs must retain Int64 precision")
+        print("PASS: account isolation, self protection, persistence, extension refresh, concurrent 230 peers, Int64 precision")
+    }
+}
