+import Foundation
+import UIKit
+import Display
+import AccountContext
+import TelegramCore
+import TelegramPresentationData
+import SGSimpleSettings
+
+final class SwirixHiddenChatsController: ViewController, UITableViewDataSource, UITableViewDelegate {
+    private let context: AccountContext
+    private var peers: [EnginePeer]
+    private var backgroundObserver: NSObjectProtocol?
+    private let table = UITableView(frame: .zero, style: .plain)
+
+    init(context: AccountContext, peers: [EnginePeer]) {
+        self.context = context
+        self.peers = peers.sorted { $0.id.toInt64() < $1.id.toInt64() }
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        super.init(navigationBarPresentationData: NavigationBarPresentationData(presentationData: data))
+        self.title = "Приховані — натисни, щоб повернути"
+        self.table.dataSource = self
+        self.table.delegate = self
+        self.table.contentInsetAdjustmentBehavior = .never
+        self.table.backgroundColor = data.theme.list.plainBackgroundColor
+        self.backgroundObserver = NotificationCenter.default.addObserver(forName: UIApplication.willResignActiveNotification, object: nil, queue: .main) { [weak self] _ in
+            self?.table.isHidden = true
+            self?.peers.removeAll()
+            self?.dismiss()
+        }
+    }
+
+    deinit {
+        if let observer = self.backgroundObserver { NotificationCenter.default.removeObserver(observer) }
+    }
+
+    required init(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.table.frame = self.view.bounds
+        self.table.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        self.view.addSubview(self.table)
+    }
+
+    override func containerLayoutUpdated(_ layout: ContainerViewLayout, transition: ContainedViewLayoutTransition) {
+        super.containerLayoutUpdated(layout, transition: transition)
+        let navigationBarHeight = self.navigationLayout(layout: layout).navigationFrame.maxY
+        self.table.frame = CGRect(origin: .zero, size: layout.size)
+        self.table.contentInset = UIEdgeInsets(top: navigationBarHeight, left: layout.safeInsets.left, bottom: layout.intrinsicInsets.bottom, right: layout.safeInsets.right)
+        self.table.scrollIndicatorInsets = self.table.contentInset
+    }
+
+    func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return self.peers.count }
+
+    func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = tableView.dequeueReusableCell(withIdentifier: "peer") ?? UITableViewCell(style: .default, reuseIdentifier: "peer")
+        let data = self.context.sharedContext.currentPresentationData.with { $0 }
+        cell.textLabel?.text = self.peers[indexPath.row].displayTitle(strings: data.strings, displayOrder: data.nameDisplayOrder)
+        cell.backgroundColor = data.theme.list.plainBackgroundColor
+        cell.textLabel?.textColor = data.theme.list.itemPrimaryTextColor
+        cell.accessoryType = .disclosureIndicator
+        return cell
+    }
+
+    func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        let peer = self.peers.remove(at: indexPath.row)
+        SwirixHiddenChats.shared.setHidden(account: self.context.account.peerId.toInt64(), peer: peer.id.toInt64(), hidden: false)
+        tableView.deleteRows(at: [indexPath], with: .automatic)
+    }
+}
