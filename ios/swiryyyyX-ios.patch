@@ -0,0 +1,12 @@
+import Foundation
+import SwiftSignalKit
+
+public func swirixHiddenChatsChanged() -> Signal<Void, NoError> {
+    return Signal { subscriber in
+        let observer = NotificationCenter.default.addObserver(forName: SwirixHiddenChats.changed, object: nil, queue: nil) { _ in
+            subscriber.putNext(())
+        }
+        subscriber.putNext(())
+        return ActionDisposable { NotificationCenter.default.removeObserver(observer) }
+    }
+}
